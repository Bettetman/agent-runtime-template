AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8010
AGENT_RUNTIME_GATEWAY_TOKEN=replace-with-a-local-gateway-token
AGENT_RUNTIME_WORKING_DIR=.agent-runtime
# 业务 Agent Tool 只通过 Java 内部网关访问已声明 Endpoint。
AGENT_RUNTIME_BACKEND_BASE_URL=http://127.0.0.1:8080
AGENT_RUNTIME_TOOL_GATEWAY_TOKEN=replace-with-a-local-tool-gateway-token

MODEL_NAME=deepseek:deepseek-chat
MODEL_API_KEY=replace-with-your-model-token
# OpenAI、Anthropic、DeepSeek 官方地址可留空；Qwen 等兼容服务填写对应地址。
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
