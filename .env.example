AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8010
AGENT_RUNTIME_WORKING_DIR=.agent-runtime
# 行外使用 local；行内部署使用 production。
AGENT_RUNTIME_PROFILE=local
# false 使用匿名会话；true 按 AUTH_MODE 使用 local Mock 或行内统一认证。
AGENT_RUNTIME_AUTH_ENABLED=false
# 行外联调使用 local；行内部署改为 enterprise 并提供适配器工厂。
AGENT_RUNTIME_AUTH_MODE=local
AGENT_RUNTIME_PUBLIC_AUTH_ADAPTER_FACTORY=
# local Mock 是固定用户和内存令牌，不接收账号密码、不创建数据库表。
AGENT_RUNTIME_MOCK_TOKEN_TTL_SECONDS=3600
AGENT_RUNTIME_MOCK_USER_ID=local-user
AGENT_RUNTIME_MOCK_EMPLOYEE_ID=local-employee
AGENT_RUNTIME_MOCK_SAP_ID=local-sap
AGENT_RUNTIME_MOCK_ENTERPRISE_ID=local-enterprise
# 仅 Auth 关闭时使用，必须为至少 32 字符的随机密钥。
AGENT_RUNTIME_ANONYMOUS_SESSION_SECRET=replace-with-at-least-32-random-characters
AGENT_RUNTIME_ANONYMOUS_SESSION_TTL_SECONDS=86400
AGENT_RUNTIME_ANONYMOUS_COOKIE_NAME=agent_runtime_session
AGENT_RUNTIME_COOKIE_SECURE=false
# 逗号分隔的 Frontend Origin，禁止使用 *。
AGENT_RUNTIME_ALLOWED_ORIGINS=http://127.0.0.1:5173
# 仅由 XCodeAgent 显式本地调试启动注入，普通预览和生产环境留空。
AGENT_RUNTIME_DEBUG_TOKEN=

MODEL_NAME=deepseek:deepseek-chat
MODEL_API_KEY=replace-with-your-model-token
# OpenAI、Anthropic、DeepSeek 官方地址可留空；Qwen 等兼容服务填写对应地址。
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
